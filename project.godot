config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GTAWorld"
run/main_scene="res://scenes/select.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.921875, 0.921875, 0.957031, 1)
config/icon="res://icon.png"
